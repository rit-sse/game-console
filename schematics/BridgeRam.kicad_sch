	(text "Latching is disabled to the CPU when busy\nand output is also off.\nWhen GPU is using, Latch is ON, and output is\nopen when DMA is on OR when MPU needs it"
		(exclude_from_sim no)
		(at 194.818 22.098 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1f2fe4ed-8bb8-42e3-b55c-6749ba10633e")
	)
	(text "The CPU will only ever write\nthe Bridge, not read"
		(exclude_from_sim no)
		(at 204.724 144.526 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "72902026-62f4-438a-8f6c-a6c55c194e56")
	)
	(text "BridgeBusy is logical HIGH when \nthe GPU is trying to access it, \nso invert it to enable chip access"
		(exclude_from_sim no)
		(at 171.196 21.336 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "856b7547-7e88-4303-a52d-5fcc9bc66546")
	)
	(text "The GPU will only ever read\nfrom the Bridge, never write"
		(exclude_from_sim no)
		(at 92.71 145.796 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8fd8537b-507f-4f40-a2b4-8064b24a5ed3")
	)
