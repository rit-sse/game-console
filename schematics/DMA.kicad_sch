	)
	(text "When !BridgeAddr[0] && IO[7], an EOL occurs\nnormally, !BridgeAddr[0] leads to an IO[7] of value 1\n\nWhen !BridgeAddr[0] && IO[7] && IO[0], then interrupt"
		(exclude_from_sim no)
		(at 167.132 237.236 90)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "28bcf303-1169-49a9-b936-70c669997517")
	)
	(text "Turn Off output to \nFrame Buffer when handing\ncontrol over to MPU"
		(exclude_from_sim no)
		(at 275.59 349.504 90)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "37b83cd1-50f9-43e1-a694-5cfe08af0af0")
	)
	(text "NOTE: BridgeIO7 is not on the BUS"
		(exclude_from_sim no)
		(at 229.87 185.166 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "65ac2fce-ec1b-423a-a3c2-c6ab112e14be")
	)
	(text "The first MUX takes a byte at a time from \nthe Asset EEPROm (4 pixels) and splits it\ninto two to pick from in the next\n"
		(exclude_from_sim no)
		(at 189.992 278.638 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "83dd83e8-2a7f-4f0d-b09e-7f56dab03749")
	)
	(text "The second MUX splits the two pixels grabbed\nfrom the first MUX. The LSB output from the MUX \ncontains the color ID of a pixel, which will then be\ncombined with a Pallette ID grabbed from the BridgeIO\ndata latches. A is the first pixel, B is the second"
		(exclude_from_sim no)
		(at 179.324 324.104 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "86258fa9-7490-42a1-86bb-aef585f43435")
	)
	(text "The moment a render is requested, \nthe GPU MPU will set these values\nfor CamX and CamY\n"
		(exclude_from_sim no)
		(at 17.018 84.328 90)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c66544a0-7637-4b31-aa6d-6983874381af")
	)
	(text "AssetID's are used with Sprite Y and \nSprite X[0] to index AssetEEPROM"
		(exclude_from_sim no)
		(at 230.886 254.508 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d54c35fa-fcf6-4835-b14c-2c48c97465f9")
	)
	(text "Interrupts Block\nProgression until\nInterrupt is cleared"
		(exclude_from_sim no)
		(at 140.97 234.442 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "eb1a7890-83e5-40c9-9894-8297ab9c3119")
	)
	(text "0: Horizontal\n1: Vertical"
		(exclude_from_sim no)
		(at 85.471 280.67 90)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f6093e28-47fb-449e-9029-8bd26e419815")
	)
