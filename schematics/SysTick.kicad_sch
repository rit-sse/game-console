	(text "~{OE}SysTick is bit 3 of the Addr range\n(the 8 in [0080:008F])\nThe remaining 3 bits of this zero page\nrange address which of the 3 bytes systick \ncan be configured with"
		(exclude_from_sim no)
		(at 209.042 265.176 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0cb32e31-5d8e-4372-84ae-438781aeaa22")
	)
	(text "When you set the DLatches OR \nthe a tick is observed, reset \ncounters"
		(exclude_from_sim no)
		(at 374.904 52.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "29733b3d-75b8-4016-a3d4-13652c4cfe07")
	)
	(text "On LOW pulse of ~{S}, \nQ2 will output HIGH\nOn LOW pulse of ~{R}, \nit will reset the pin\n\nBasically, it will only\nreset AFTER you're done\nviewing its state"
		(exclude_from_sim no)
		(at 29.464 75.692 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6ae3c241-cc73-4ea3-8f9a-92e93e9b0337")
	)
